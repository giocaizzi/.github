# a compliant workflow; expected: modes.out (empty), modes.pins, modes.norm, modes.subst (Makefile sets reps)
on:
  pull_request:
concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
permissions:
  contents: read
jobs:
  a:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
    steps:
      - uses: actions/checkout@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa # v7.1.0
      - uses: github/codeql-action/upload-sarif@1111111111111111111111111111111111111111 # v4.1.0
      - uses: ./local
  reuse:
    uses: owner/repo/.github/workflows/x.yml@2222222222222222222222222222222222222222 # v1.0.0

wf_permissions	top level: permissions: write-all
wf_timeout	jobs without a positive timeout-minutes: build
wf_concurrency	top level: group without ${{ github.run_id }} on a push or merge_group run; top level: cancel-in-progress: true on a push or merge_group run
wf_pinned	not pinned by SHA: actions/checkout@v7; not pinned by SHA: owner/action@main; docker image not pinned by sha256 digest: docker://alpine:3; not pinned by SHA: owner/short@3d3c42e; no version comment: owner/repo/.github/workflows/ci.yml@3d3c42e5aac5ba805825da76410c181273ba90b1
local	./local-action

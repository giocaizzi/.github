#!/usr/bin/env bash
# A stand-in for `gh` in scripts/test-sync.sh: answers the `gh api` calls an audit of repo `r` makes.
#   FAKE_GH=fail       the repo lookup fails (HTTP 502)
#   FAKE_GH=truncated  the repo tree is truncated
#   FAKE_GH=files      the tree holds one blob at FAKE_PATH (bad-workflow.yml or bad-action.yml here) and one per
#                      comma-separated path in FAKE_EXTRA (contents `x`; a path ending `.forbidden` answers HTTP 403).
#                      Blobs are served only by the sha the tree lists: `action` or `workflow`, `extra`, `forbidden`.
#   FAKE_PRIV=false    a public repo (default private)
#   FAKE_GQL=<json>    the GraphQL `repository` object (default: only squashMergeAllowed, so the other keys read null)
#   FAKE_PROBE=403|ok  the vulnerability-alerts, automated-security-fixes and private-vulnerability-reporting probes
#                      (default HTTP 404: disabled)
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
case ${1:-} in
  label) exit 0 ;; # gh label list: no labels
  repo) jq -cn --argjson n "${FAKE_LIST_N:-0}" '[range($n) | {name: "r\(.)", visibility: "PRIVATE"}]'; exit 0 ;; # gh repo list
  api) ;;
  *) echo "fake gh: unsupported $1" >&2; exit 1 ;;
esac
[ "$2" = --paginate ] && set -- "$1" "${@:3}"
path=$2 q=""
while [ $# -gt 0 ]; do [ "$1" = -q ] && q=$2; shift; done
gql=${FAKE_GQL:-'{"squashMergeAllowed":true}'}
case $path in
  graphql) json=$(jq -cn --argjson g "$gql" '{data: {repository: $g}}') ;;
  repos/*/.github/git/trees/*) json='{"truncated":false,"tree":[]}' ;;
  repos/*/r)
    [ "${FAKE_GH:-}" = fail ] && { echo "gh: Server Error (HTTP 502)" >&2; exit 1; }
    json=$(jq -cn --argjson p "${FAKE_PRIV:-true}" '{private: $p, default_branch: "main", topics: ["std-docs"], has_pages: false}') ;;
  repos/*/r/git/trees/*)
    if [ "${FAKE_GH:-}" = files ]; then
      json=$(jq -cn --arg p "$FAKE_PATH" --arg e "${FAKE_EXTRA:-}" '
        def sha: if endswith(".forbidden") then "forbidden" elif test("(^|/)action\\.yml$") then "action" else "workflow" end;
        def extra: if endswith(".forbidden") then "forbidden" else "extra" end;
        {truncated: false, tree: ([{type: "blob", mode: "100644", sha: ($p | sha), path: $p}]
          + [$e | split(",")[] | select(length > 0) | {type: "blob", mode: "100644", sha: extra, path: .}])}')
    else json='{"truncated":true,"tree":[]}'; fi ;;
  repos/*/r/git/blobs/*)
    case ${path##*/} in
      forbidden) echo "gh: Resource not accessible by personal access token (HTTP 403)" >&2; exit 1 ;;
      action) cat "$here/bad-action.yml" ;;
      workflow) cat "$here/bad-workflow.yml" ;;
      extra) echo x ;;
      *) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
    esac
    exit 0 ;;
  repos/*/r/rulesets) json='[]' ;;
  repos/*/r/vulnerability-alerts|repos/*/r/automated-security-fixes|repos/*/r/private-vulnerability-reporting)
    case ${FAKE_PROBE:-} in
      403) echo "gh: Resource not accessible by personal access token (HTTP 403)" >&2; exit 1 ;;
      ok) json='{"enabled":true}' ;;
      *) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
    esac ;;
  *) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
esac
if [ -n "$q" ]; then jq -r "$q" <<<"$json"; else printf '%s\n' "$json"; fi
